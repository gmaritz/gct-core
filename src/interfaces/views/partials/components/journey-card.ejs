<%
  const cardVariant = locals.variant || 'secondary';
  const headingTag = cardVariant === 'primary' ? 'h2' : 'h3';
  const headingClass = headingTag === 'h2' ? 'journey-card__name journey-card__name--primary' : 'journey-card__name';
  const wrapperClass = ['homepage-showcase__journey-card', `homepage-showcase__journey-card--${cardVariant}`, 'journey-card', 'card'].join(' ');
  const image = locals.image || {};
  const price = locals.price || {};
  const saving = locals.saving || {};
  const primaryCTA = locals.primaryCTA || {};
  const highlights = Array.isArray(locals.highlights) ? locals.highlights : [];
  const ariaLabel = locals.ariaLabel || locals.title;
  const imageFocalPosition = image.focalPosition || 'center';
%>
<article class="<%= wrapperClass %>" aria-label="<%= ariaLabel %>">
  <img class="journey-card__image" src="<%= image.src %>" alt="<%= image.alt %>" width="<%= image.width || 1600 %>" height="<%= image.height || 900 %>" style="object-position: <%= imageFocalPosition %>;">
  <div class="journey-card__content">
    <<%= headingTag %> class="<%= headingClass %>"><%= locals.title %></<%= headingTag %>>
    <p class="journey-card__destination"><%= locals.destination %></p>
    <p class="journey-card__duration"><%= locals.duration %></p>
    <ul class="journey-card__highlights" aria-label="Journey highlights">
      <% highlights.forEach((highlight) => { %>
        <li><%= highlight %></li>
      <% }); %>
    </ul>
    <p class="journey-card__price"><%= price.display %></p>
    <div class="journey-card__actions">
      <a class="button button--<%= primaryCTA.style || 'primary' %>" href="<%= primaryCTA.href || '#journey-planning' %>"><%= primaryCTA.label || 'View Journey' %></a>
      <span class="journey-card__saving"><%= saving.display || 'Save 0%' %></span>
    </div>
  </div>
</article>
