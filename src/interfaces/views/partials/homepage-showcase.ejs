<%
  const journeys = Array.isArray(curatedJourneys) ? curatedJourneys : [];
%>
<section class="homepage-showcase" aria-labelledby="homepage-showcase-title">
  <div class="container">
    <div class="homepage-showcase__layout">
      <div class="homepage-showcase__editorial">
        <p class="homepage-showcase__kicker">Curated Private Journeys</p>
        <h1 id="homepage-showcase-title">Discover South Africa Through Carefully Curated Journeys.</h1>
        <p class="homepage-showcase__intro">
          From the vineyards of Stellenbosch to the coastline of the Garden Route, every Go Cape Tours journey combines exceptional accommodation, authentic experiences and local expertise to create unforgettable memories.
        </p>
        <div class="homepage-showcase__actions">
          <a class="button button--primary" href="#featured-experiences">Explore Experiences</a>
          <a class="button button--secondary" href="#journey-planning">Plan Your Journey</a>
        </div>
      </div>

      <div class="homepage-showcase__journeys" aria-label="Curated journey collection">
        <% journeys.forEach((journey) => { %>
          <%- include('./components/journey-card.ejs', { ...journey }) %>
        <% }); %>
      </div>
    </div>
  </div>
</section>