<%
  const homepageShowcase = homepageShowcaseViewModel || {};
  const editorial = homepageShowcase.editorial || {};
  const journeys = Array.isArray(homepageShowcase.journeys) ? homepageShowcase.journeys : [];
%>
<section class="homepage-showcase" aria-labelledby="homepage-showcase-title">
  <div class="container">
    <div class="homepage-showcase__layout">
      <div class="homepage-showcase__editorial">
        <p class="homepage-showcase__kicker"><%= editorial.eyebrow %></p>
        <h1 id="homepage-showcase-title"><%= editorial.heading %></h1>
        <p class="homepage-showcase__intro"><%= editorial.narrative %></p>
        <div class="homepage-showcase__actions">
          <a class="button button--<%= editorial.primaryCTA?.style || 'primary' %>" href="<%= editorial.primaryCTA?.href || '#featured-experiences' %>"><%= editorial.primaryCTA?.label || 'Explore Experiences' %></a>
          <a class="button button--<%= editorial.secondaryCTA?.style || 'secondary' %>" href="<%= editorial.secondaryCTA?.href || '#journey-planning' %>"><%= editorial.secondaryCTA?.label || 'Plan Your Journey' %></a>
        </div>
      </div>

      <div class="homepage-showcase__journeys" aria-label="Curated journey collection">
        <% journeys.forEach((journey) => { %>
          <%- include('./components/journey-card.ejs', { ...journey }) %>
        <% }); %>
      </div>
    </div>
  </div>
</section>