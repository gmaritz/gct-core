<article class="journey-detail">
  <div class="container">
    <header class="journey-detail__header">
      <img class="journey-detail__image" src="<%= journeyDetailViewModel.image.src %>" alt="<%= journeyDetailViewModel.image.alt %>" width="<%= journeyDetailViewModel.image.width %>" height="<%= journeyDetailViewModel.image.height %>">
      <h1><%= journeyDetailViewModel.title %></h1>
      <p><%= journeyDetailViewModel.subtitle %></p>
      <p><strong><%= journeyDetailViewModel.destinations.join(" + ") %></strong> · <%= journeyDetailViewModel.duration %></p>
      <% if (journeyDetailViewModel.summary) { %><p><%= journeyDetailViewModel.summary %></p><% } %>
    </header>
    <section aria-labelledby="journey-itinerary-title"><h2 id="journey-itinerary-title">Itinerary</h2><% if (journeyDetailViewModel.itinerary.length === 0) { %><p>Itinerary details will be confirmed during planning.</p><% } else { %><ol><% journeyDetailViewModel.itinerary.forEach((item) => { %><li><strong>Day <%= item.day %><% if (item.title) { %>: <%= item.title %><% } %></strong><ul><% item.experiences.forEach((experience) => { %><li><%= experience %></li><% }); %></ul></li><% }); %></ol><% } %></section>
    <section aria-labelledby="journey-accommodation-title"><h2 id="journey-accommodation-title">Accommodation</h2><% if (journeyDetailViewModel.accommodation.length === 0) { %><p>Accommodation details will be confirmed during planning.</p><% } else { %><% journeyDetailViewModel.accommodation.forEach((stay) => { %><p><strong><%= stay.name %></strong><% if (stay.category) { %> · <%= stay.category %><% } %><% if (stay.rating) { %> · <%= stay.rating %> stars<% } %><% if (stay.nights) { %> · <%= stay.nights %> nights<% } %></p><% }); %><% } %></section>
    <section aria-labelledby="journey-experiences-title"><h2 id="journey-experiences-title">Included experiences</h2><% if (journeyDetailViewModel.experiences.length === 0) { %><p>No experiences are currently listed.</p><% } else { %><ul><% journeyDetailViewModel.experiences.forEach((experience) => { %><li><%= experience.name %><% if (experience.type) { %> · <%= experience.type %><% } %></li><% }); %></ul><% } %></section>
    <section aria-label="Journey pricing"><h2>Pricing</h2><p><%= journeyDetailViewModel.pricing.state === "AVAILABLE" && journeyDetailViewModel.pricing.price ? journeyDetailViewModel.pricing.price.display : "Price on request" %></p></section>
    <form method="post" action="<%= journeyDetailViewModel.selectionAction.href %>">
      <button class="button button--primary" type="submit"><%= journeyDetailViewModel.selectionAction.label %></button>
    </form>
  </div>
</article>