<article class="guest-information">
  <div class="container">
    <nav class="guest-information__nav" aria-label="Breadcrumb navigation">
      <a class="guest-information__back-link" href="/ui/journeys/<%= guestInformationViewModel.journeyId %>/quote">← Back to Quote & Pricing</a>
    </nav>

    <header class="guest-information__header">
      <p class="journey-detail__eyebrow">Guest information</p>
      <h1 class="guest-information__title"><%= guestInformationViewModel.journeyTitle %></h1>
      <p class="guest-information__subtitle">Provide the contact and traveller details required for your reservation review.</p>
    </header>

    <% if (guestInformationViewModel.errors.length > 0) { %>
      <div class="feedback feedback--error guest-information__error-summary" id="guest-information-errors" role="alert" tabindex="-1">
        <h2 class="guest-information__error-title">Please correct the following:</h2>
        <ul class="guest-information__error-list">
          <% guestInformationViewModel.errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/ui/journeys/<%= guestInformationViewModel.journeyId %>/guest-information"<% if (guestInformationViewModel.errors.length > 0) { %> aria-describedby="guest-information-errors"<% } %> data-protect-submit>
      <div class="guest-information__layout">
        <div class="guest-information__main">
          <fieldset class="guest-information__fieldset">
            <legend class="guest-information__legend">Booking contact</legend>
            <p class="guest-information__fieldset-subtext">Primary contact for booking updates, documentation, and confirmation notifications.</p>

            <div class="guest-information__form-grid">
              <div class="form-group">
                <label class="form-label" for="contact-email">Contact Email <span class="form-required" aria-hidden="true">*</span></label>
                <input class="form-input" id="contact-email" name="contact[email]" type="email" autocomplete="email" required value="<%= guestInformationViewModel.contact.email %>"<% if (guestInformationViewModel.errors.some((err) => err.toLowerCase().includes("contact email"))) { %> aria-invalid="true"<% } %>>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-phone">Contact Telephone <span class="form-optional">(Optional)</span></label>
                <input class="form-input" id="contact-phone" name="contact[phone]" type="tel" autocomplete="tel" value="<%= guestInformationViewModel.contact.phone || '' %>">
              </div>
            </div>
          </fieldset>

          <fieldset class="guest-information__fieldset">
            <legend class="guest-information__legend">Traveller Details</legend>
            <p class="guest-information__fieldset-subtext">Personal details for all guests travelling on this curated journey.</p>

            <div class="guest-information__travellers-list">
              <% guestInformationViewModel.travellers.forEach((traveller, index) => { %>
                <article class="card guest-information__traveller-card">
                  <div class="guest-information__traveller-header">
                    <h2 class="guest-information__traveller-title">
                      <%= index === guestInformationViewModel.leadTravellerIndex ? 'Lead Traveller (Guest 1)' : `Traveller ${index + 1}` %>
                    </h2>
                    <span class="guest-information__traveller-badge"><%= traveller.travellerType %></span>
                  </div>

                  <input type="hidden" name="travellers[<%= index %>][travellerType]" value="<%= traveller.travellerType %>">

                  <div class="guest-information__form-grid">
                    <div class="form-group">
                      <label class="form-label" for="traveller-<%= index %>-first-name">First Name <span class="form-required" aria-hidden="true">*</span></label>
                      <input class="form-input" id="traveller-<%= index %>-first-name" name="travellers[<%= index %>][firstName]" autocomplete="given-name" required value="<%= traveller.firstName %>"<% if (guestInformationViewModel.errors.some((err) => err.toLowerCase().includes(`traveller ${index + 1} first name`))) { %> aria-invalid="true"<% } %>>
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="traveller-<%= index %>-last-name">Last Name <span class="form-required" aria-hidden="true">*</span></label>
                      <input class="form-input" id="traveller-<%= index %>-last-name" name="travellers[<%= index %>][lastName]" autocomplete="family-name" required value="<%= traveller.lastName %>"<% if (guestInformationViewModel.errors.some((err) => err.toLowerCase().includes(`traveller ${index + 1} last name`))) { %> aria-invalid="true"<% } %>>
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="traveller-<%= index %>-email">Email Address <span class="form-required" aria-hidden="true">*</span></label>
                      <input class="form-input" id="traveller-<%= index %>-email" name="travellers[<%= index %>][email]" type="email" autocomplete="email" required value="<%= traveller.email %>"<% if (guestInformationViewModel.errors.some((err) => err.toLowerCase().includes(`traveller ${index + 1} email`))) { %> aria-invalid="true"<% } %>>
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="traveller-<%= index %>-nationality">Nationality <span class="form-optional">(Optional)</span></label>
                      <input class="form-input" id="traveller-<%= index %>-nationality" name="travellers[<%= index %>][nationality]" autocomplete="country-name" value="<%= traveller.nationality || '' %>">
                    </div>

                    <% if (traveller.travellerType === 'CHILD') { %>
                      <div class="form-group">
                        <label class="form-label" for="traveller-<%= index %>-dob">Date of Birth <span class="form-required" aria-hidden="true">*</span></label>
                        <input class="form-input" id="traveller-<%= index %>-dob" name="travellers[<%= index %>][dateOfBirth]" type="date" required value="<%= traveller.dateOfBirth || '' %>">
                      </div>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>
          </fieldset>

          <input type="hidden" name="leadTravellerIndex" value="<%= guestInformationViewModel.leadTravellerIndex %>">
        </div>

        <aside class="guest-information__sidebar">
          <div class="card guest-information__action-card">
            <div class="guest-information__summary-box">
              <p class="guest-information__summary-label">Reservation Step 3 of 5</p>
              <h3 class="guest-information__summary-title">Guest Details</h3>
              <p class="guest-information__summary-text">Your information will be used strictly for reservation review, guest confirmation, and luxury itinerary coordination.</p>
            </div>

            <div class="guest-information__actions">
              <button class="button button--primary button--full" type="submit">Continue to reservation review</button>
              <a class="button button--secondary button--full" href="/ui/journeys/<%= guestInformationViewModel.journeyId %>/quote">Back to quote</a>
            </div>
          </div>
        </aside>
      </div>
    </form>
  </div>
</article>
