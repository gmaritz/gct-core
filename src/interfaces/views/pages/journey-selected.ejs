<article class="journey-detail">
  <div class="container">
    <header class="journey-detail__header">
      <p class="journey-detail__eyebrow">Journey selected</p>
      <h1 id="journey-selected-title" class="journey-detail__title"><%= selection.title %></h1>
      <p class="journey-detail__subtitle">Your journey selection is ready for the next planning step.</p>
    </header>

    <div class="card step-card">
      <p class="step-card__text">Accommodation availability and final package pricing will be confirmed in the subsequent steps.</p>
      <div class="step-card__action">
        <a class="button button--primary" href="<%= selectionHref %>">Select accommodation</a>
      </div>
    </div>
  </div>
</article>