{
  "name": "gct-core",
  "version": "1.0.0",
  "description": "Go Cape Tours Core Platform - Premium Travel Commerce Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmaritz/gct-core.git"
  },
  "keywords": [
    "travel",
    "commerce",
    "ddd",
    "clean-architecture"
  ],
  "author": "Go Cape Tours",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gmaritz/gct-core/issues"
  },
  "homepage": "https://github.com/gmaritz/gct-core#readme",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
  "express": "^4.22.2",
  "prisma": "^5.22.0",
  "@prisma/client": "^5.22.0",
  "uuid": "^9.0.1"
},
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}

