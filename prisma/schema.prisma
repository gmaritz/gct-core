  @@map("accommodation_type")
}

model CustomerType {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  customers   Customer[]

  @@index([code])
  @@map("customer_type")
}

model BookingNoteType {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  active      Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  bookingNotes BookingNote[]

  @@index([code])
  @@map("booking_note_type")
}

model OperationalNoteType {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  active      Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  operationalNotes OperationalNote[]

  @@index([code])
  @@map("operational_note_type")
}

model MediaType {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  active      Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  media       Media[]

  @@index([code])
  @@map("media_type")
}

model AccommodationCategory {
  id              String            @id @default(uuid())
  code            String            @unique
  name            String
  active          Boolean           @default(true)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  accommodations  Accommodation[]

  @@index([code])
  @@map("accommodation_category")
}

model TrailerType {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  trailers    Trailer[]

  @@index([code])
  @@map("trailer_type")
}

model SynchronisationJobType {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  active      Boolean              @default(true)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  jobs        SynchronisationJob[]

  @@index([code])
  @@map("synchronisation_job_type")
}

model SynchronisationJobStatus {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  active      Boolean              @default(true)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  jobs        SynchronisationJob[]

  @@index([code])
  @@map("synchronisation_job_status")
}

model ImportBatchStatus {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?

  importBatches ImportBatch[]

  @@index([code])
  @@map("import_batch_status")
}

model FinancialAdjustmentType {
  id            String                @id @default(uuid())
  code          String                @unique
  name          String
  active        Boolean               @default(true)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?

  adjustments   FinancialAdjustment[]

  @@index([code])
  @@map("financial_adjustment_type")
}

model ReconciliationType {
  id                String                    @id @default(uuid())
  code              String                    @unique
  name              String
  active            Boolean                   @default(true)

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?

  reconciliations   FinancialReconciliation[]

  @@index([code])
  @@map("reconciliation_type")
}

model ReconciliationStatus {
  id                String                    @id @default(uuid())
  code              String                    @unique
  name              String
  active            Boolean                   @default(true)

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?

  reconciliations   FinancialReconciliation[]

  @@index([code])
  @@map("reconciliation_status")
}

// =========================================================
// Commercial Domain
// =========================================================

model Customer {
  id                String      @id @default(uuid())
  customerNumber    String      @unique
  customerTypeId    String
  firstName         String?
  lastName          String?
  companyName       String?
  email             String
  mobileNumber      String?
  preferredLanguageId String?
  preferredCurrencyId String?
  active            Boolean     @default(true)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?
  version           Int         @default(1)

  travellers        Traveller[]
  quotes            Quote[]
  bookings          Booking[]
  customerType      CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  preferredLanguage Language?  @relation(fields: [preferredLanguageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  preferredCurrency Currency?  @relation(fields: [preferredCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([email])
  @@index([customerNumber])
  @@index([customerTypeId])
  @@index([preferredLanguageId])
  @@index([preferredCurrencyId])
  @@map("customer")
}

model Traveller {
  id                   String      @id @default(uuid())
  customerId           String
  title                String?
  firstName            String
  lastName             String
  preferences          Json?
  dateOfBirth          DateTime? @db.Date
  countryId            String?
  passportNumber       String?
  passportExpiry       DateTime? @db.Date
  dietaryRequirements  String?
  mobilityRequirements String?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  country              Country?    @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId])
  @@index([countryId])
  @@map("traveller")
}

model Quote {
  id           String      @id @default(uuid())
  customerId   String
  quoteNumber  String      @unique
  quoteDate      DateTime @db.Date
  validUntil     DateTime @db.Date
  totalAmount    Decimal      @db.Decimal(19,4)
  currencyId     String
  quoteStatusId  String
  notes        String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int         @default(1)

  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency       Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quoteStatus    QuoteStatus   @relation(fields: [quoteStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId])
  @@index([currencyId])
  @@index([quoteStatusId])
  @@map("quote")
}

model Booking {
  id              String         @id @default(uuid())
  customerId      String
  bookingNumber   String         @unique
  bookingDate      DateTime @db.Date
  travelDate       DateTime @db.Date
  returnDate       DateTime? @db.Date
  bookingStatusId  String
  reservationLifecycleCode String?
  totalAmount      Decimal        @db.Decimal(19,4)
  currencyId       String
  specialRequests String?
  internalNotes   String?
  journeySnapshot Json?
  travellerSnapshots Json?
  accommodationSnapshots Json?
  pricingSnapshot Json?
  paymentSnapshot Json?
  supplierReferences Json?
  reservationTimeline Json?
  reservationMetadata Json?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  version         Int            @default(1)

  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingStatus    BookingStatus  @relation(fields: [bookingStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency         Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  bookingItems    BookingItem[]
  bookingContacts BookingContact[]
  bookingNotes    BookingNote[]
  reservations    Reservation[]
  payments        Payment[]
  invoices        Invoice[]
  itinerary       Itinerary?

  @@index([customerId])
  @@index([travelDate])
  @@index([bookingStatusId])
  @@index([currencyId])
  @@index([reservationLifecycleCode])
  @@map("booking")
}

model BookingItem {
  id         String        @id @default(uuid())
  bookingId  String
  productId  String
  quantity   Int
  unitPrice  Decimal       @db.Decimal(19,4)
  totalPrice Decimal       @db.Decimal(19,4)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  deletedBy  String?

  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reservations Reservation[]

  @@index([bookingId])
  @@index([productId])
  @@map("booking_item")
}

model BookingContact {
  id           String      @id @default(uuid())
  bookingId    String
  contactName  String
  email        String?
  mobileNumber String?
  relationship String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId])
  @@map("booking_contact")
}

model BookingNote {
  id        String      @id @default(uuid())
  bookingId String
  bookingNoteTypeId String
  note      String

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  noteType  BookingNoteType @relation(fields: [bookingNoteTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId])
  @@index([bookingNoteTypeId])
  @@map("booking_note")
}

model Reservation {
  id                   String      @id @default(uuid())
  bookingId            String
  bookingItemId        String
  supplierId           String
  reservationReference String?
  reservationStatusId  String
  reservedAt           DateTime
  confirmedAt          DateTime?
  cancelledAt          DateTime?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  booking              Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingItem          BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier             Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservationStatus    ReservationStatus @relation(fields: [reservationStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId])
  @@index([bookingItemId])
  @@index([supplierId])
  @@index([reservationStatusId])
  @@map("reservation")
}

// =========================================================
// Catalogue Domain
// =========================================================

model ProductType {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  active      Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  products    Product[]

  @@index([code])
  @@map("product_type")
}

model Destination {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  slug        String    @unique
  description String?
  latitude    Decimal?
  longitude   Decimal?
  active      Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  products    Product[]

  @@index([slug])
  @@map("destination")
}

model ProductCategory {
  id           String                   @id @default(uuid())
  code         String                   @unique
  name         String
  description  String?
  active       Boolean                  @default(true)

  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  productLinks ProductProductCategory[]

  @@map("product_category")
}

model Product {
  id               String                   @id @default(uuid())
  productCode      String                   @unique
  productTypeId    String
  destinationId    String
  name             String
  slug             String                   @unique
  shortDescription String?
  description      String?
  duration         String?
  active           Boolean                  @default(true)
  featured         Boolean                  @default(false)
  seoTitle         String?
  seoDescription   String?

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  version          Int                      @default(1)

  productType      ProductType              @relation(fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destination      Destination              @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  categories       ProductProductCategory[]
  media            Media[]
  packageProducts  PackageProduct[]
  bookingItems     BookingItem[]
  itineraryItems   ItineraryItem[]
  supplierProducts SupplierProduct[]

  tour             Tour?
  activity         Activity?
  accommodation    Accommodation?
  package          Package?

  @@index([productTypeId])
  @@index([destinationId])
  @@index([slug])
  @@map("product")
}

model ProductProductCategory {
  id         String          @id @default(uuid())
  productId  String
  categoryId String

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  createdBy  String?
  updatedBy  String?

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_product_category")
}

model Tour {
  id             String   @id @default(uuid())
  productId      String   @unique
  tourTypeId     String?
  privateOnly    Boolean  @default(true)
  minimumGuests  Int?
  maximumGuests  Int?
  pickupIncluded Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tourType       TourType? @relation(fields: [tourTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tourTypeId])
  @@map("tour")
}

model Activity {
  id               String   @id @default(uuid())
  productId        String   @unique
  durationMinutes  Int?
  minimumAge       Int?
  weatherDependent Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("activity")
}

model Accommodation {
  id           String   @id @default(uuid())
  productId    String   @unique
  accommodationTypeId String?
  supplierCode String?
  accommodationCategoryId String?
  starRating   Decimal?
  checkInTime  String?
  checkOutTime String?

