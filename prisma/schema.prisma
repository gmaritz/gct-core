  @@index([code])
  @@map("notification_type")
}

model PackageType {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

