datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================
// Reference / Lookup Domain
// =========================================================

model Language {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  active      Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  customers   Customer[]

  @@index([code])
  @@map("language")
}

model Country {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  active      Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  travellers  Traveller[]

  @@index([code])
  @@map("country")
}

