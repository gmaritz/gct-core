  active             Boolean   @default(true)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  supplier           Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([supplierId])
  @@map("mapping_rule")
}

// =========================================================
// Financial Domain
// =========================================================

model Currency {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  symbol            String?
  decimalPlaces     Int            @default(2)
  active            Boolean        @default(true)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?

  customers         Customer[]
  quotes            Quote[]
  bookings          Booking[]
  supplierAgreements SupplierAgreement[]
  rates             Rate[]
  payments          Payment[]

  exchangeRatesFrom ExchangeRate[] @relation("ExchangeRateFrom")
  exchangeRatesTo   ExchangeRate[] @relation("ExchangeRateTo")

  @@index([code])
  @@map("currency")
}

model ExchangeRate {
  id             String    @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  exchangeRate   Decimal
  effectiveDate  DateTime @db.Date

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  fromCurrency   Currency  @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toCurrency     Currency  @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
  @@map("exchange_rate")
}

model TaxRate {
  id            String    @id @default(uuid())
  taxCode       String    @unique
  description   String?
  percentage    Decimal
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?

  @@index([taxCode])
  @@map("tax_rate")
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  provider  String?
  active    Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  payments  Payment[]

  @@map("payment_method")
}

model Payment {
  id                   String                @id @default(uuid())
  bookingId            String
  paymentMethodId      String
  paymentReference     String                @unique
  transactionReference String?
  amount               Decimal               @db.Decimal(19,4)
  currencyId           String
  paymentStatusId      String
  paymentDate          DateTime @db.Date
  receivedAt           DateTime?
  gatewayResponse      Json?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?
  version              Int                   @default(1)

  booking              Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentMethod        PaymentMethod         @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency             Currency              @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentStatus        PaymentStatus         @relation(fields: [paymentStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  allocations          PaymentAllocation[]
  refunds              Refund[]
  adjustments          FinancialAdjustment[]

  @@index([bookingId])
  @@index([paymentMethodId])
  @@index([currencyId])
  @@index([paymentStatusId])
  @@index([paymentDate])
  @@map("payment")
}

model PaymentAllocation {
  id              String    @id @default(uuid())
  paymentId       String
  invoiceId       String
  allocatedAmount Decimal   @db.Decimal(19,4)
  allocatedAt     DateTime  @default(now())

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?

  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

model Refund {
  id              String    @id @default(uuid())
  paymentId       String
  refundReference String    @unique
  amount          Decimal   @db.Decimal(19,4)
  refundReason    String?
  refundedAt      DateTime
  refundStatusId  String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refundStatus    RefundStatus @relation(fields: [refundStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paymentId])
  @@index([refundStatusId])
  @@map("refund")
}

model FinancialAdjustment {
  id             String    @id @default(uuid())
  paymentId      String
  adjustmentTypeId String
  amount         Decimal   @db.Decimal(19,4)
  reason         String?
  adjustedAt     DateTime

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  payment        Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adjustmentType FinancialAdjustmentType @relation(fields: [adjustmentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paymentId])
  @@index([adjustmentTypeId])
  @@map("financial_adjustment")
}

model Invoice {
  id            String              @id @default(uuid())
  bookingId     String
  invoiceNumber String              @unique
  invoiceDate     DateTime @db.Date
  dueDate         DateTime? @db.Date
  subtotal        Decimal        @db.Decimal(19,4)
  taxAmount       Decimal        @db.Decimal(19,4)
  totalAmount     Decimal        @db.Decimal(19,4)
  invoiceStatusId String

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  version       Int                 @default(1)

  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceStatus InvoiceStatus       @relation(fields: [invoiceStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  allocations   PaymentAllocation[]
  creditNotes   CreditNote[]

  @@index([bookingId])
  @@index([invoiceStatusId])
  @@map("invoice")
}

model CreditNote {
  id               String    @id @default(uuid())
  invoiceId        String
  creditNoteNumber String    @unique
  amount           Decimal   @db.Decimal(19,4)
  reason           String?
  issuedAt         DateTime

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([invoiceId])
  @@map("credit_note")
}

model FinancialReconciliation {
  id                 String    @id @default(uuid())
  reconciliationDate DateTime @db.Date
  reconciliationTypeId String
  reconciliationStatusId String
  processedRecords   Int
  discrepancies      Int
  notes              String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  reconciliationType   ReconciliationType   @relation(fields: [reconciliationTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reconciliationStatus ReconciliationStatus @relation(fields: [reconciliationStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reconciliationDate])
  @@index([reconciliationTypeId])
  @@index([reconciliationStatusId])
  @@map("financial_reconciliation")
}

// =========================================================
// Operations Domain
// =========================================================

model Itinerary {
  id              String                @id @default(uuid())
  bookingId       String                @unique
  itineraryNumber String                @unique
  title           String
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  itineraryStatusId String

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  version         Int                   @default(1)

  booking         Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itineraryStatus ItineraryStatus       @relation(fields: [itineraryStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  days            ItineraryDay[]
  assignments     ResourceAssignment[]
  schedules       OperationalSchedule[]
  executions      TourExecution[]
  notes           OperationalNote[]

  @@index([bookingId])
  @@index([itineraryStatusId])
  @@map("itinerary")
}

model ItineraryDay {
  id          String          @id @default(uuid())
  itineraryId String
  dayNumber   Int
  title       String?
  description String?
  travelDate  DateTime @db.Date

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  itinerary   Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items       ItineraryItem[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@map("itinerary_day")
}

model ItineraryItem {
  id             String      @id @default(uuid())
  itineraryDayId String
  productId      String?
  startTime      DateTime?
  endTime        DateTime?
  sequence       Int
  description    String?
  location       String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([itineraryDayId])
  @@index([productId])
  @@index([sequence])
  @@map("itinerary_item")
}

model Vehicle {
  id                 String               @id @default(uuid())
  registrationNumber String               @unique
  description        String
  manufacturer       String?
  model              String?
  seatingCapacity    Int
  active             Boolean              @default(true)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?
  version            Int                  @default(1)

  assignments        ResourceAssignment[]

  @@index([registrationNumber])
  @@map("vehicle")
}

model Driver {
  id             String               @id @default(uuid())
  employeeNumber String?              @unique
  firstName      String
  lastName       String
  mobileNumber   String?
  driversLicence String?
  active         Boolean              @default(true)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  version        Int                  @default(1)

  assignments    ResourceAssignment[]

  @@index([employeeNumber])
  @@map("driver")
}

model Guide {
  id                String               @id @default(uuid())
  employeeNumber    String?              @unique
  firstName         String
  lastName          String
  languages         Json?
  guideRegistration String?
  active            Boolean              @default(true)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?
  version           Int                  @default(1)

  assignments       ResourceAssignment[]

  @@index([employeeNumber])
  @@map("guide")
}

model Trailer {
  id                 String               @id @default(uuid())
  registrationNumber String?              @unique
  description        String
  trailerTypeId      String?
  active             Boolean              @default(true)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  trailerType        TrailerType?          @relation(fields: [trailerTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments        ResourceAssignment[]

  @@index([trailerTypeId])
  @@map("trailer")
}

model ResourceAssignment {
  id               String    @id @default(uuid())
  itineraryId      String
  vehicleId        String?
  driverId         String?
  guideId          String?
  trailerId        String?
  assignedFrom     DateTime
  assignedTo       DateTime?
  assignmentStatusId String

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  itinerary        Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle          Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver           Driver?   @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guide            Guide?    @relation(fields: [guideId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trailer          Trailer?  @relation(fields: [trailerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignmentStatus AssignmentStatus @relation(fields: [assignmentStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([itineraryId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([guideId])
  @@index([trailerId])
  @@index([assignmentStatusId])
  @@map("resource_assignment")
}

model OperationalSchedule {
  id              String    @id @default(uuid())
  itineraryId     String
  scheduledStart  DateTime
  scheduledFinish DateTime
  scheduleStatusId String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  itinerary       Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scheduleStatus  ScheduleStatus @relation(fields: [scheduleStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([itineraryId])
  @@index([scheduledStart])
  @@index([scheduleStatusId])
  @@map("operational_schedule")
}

model TourExecution {
  id                 String    @id @default(uuid())
  itineraryId        String
  startedAt          DateTime?
  completedAt        DateTime?
  executionStatusId  String
  kilometresTravelled Decimal?
  customerFeedback   String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  itinerary          Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  executionStatus    ExecutionStatus @relation(fields: [executionStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([itineraryId])
  @@index([executionStatusId])
  @@map("tour_execution")
}

model OperationalNote {
  id         String    @id @default(uuid())
  itineraryId String
  operationalNoteTypeId String
  note       String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  deletedBy  String?

  itinerary  Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  noteType   OperationalNoteType @relation(fields: [operationalNoteTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([itineraryId])
  @@index([operationalNoteTypeId])
  @@map("operational_note")
}

// =========================================================
// Platform Domain
// =========================================================

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  email        String      @unique
  firstName    String
  lastName     String
  passwordHash String
  active       Boolean     @default(true)
  lastLoginAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int         @default(1)

  roles         UserRole[]
  documents     Document[]
  notifications Notification[]
  workflowEvents WorkflowEvent[]
  auditRecords  AuditRecord[]

  @@index([username])
  @@index([email])
  @@map("platform_user")
}

model Role {
  id          String           @id @default(uuid())
  roleCode    String           @unique
  name        String
  description String?
  active      Boolean          @default(true)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  users       UserRole[]
  permissions RolePermission[]

  @@index([roleCode])
  @@map("role")
}

model Permission {
  id             String           @id @default(uuid())
  permissionCode String           @unique
  description    String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  roles          RolePermission[]

  @@index([permissionCode])
  @@map("permission")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

model Document {
  id           String    @id @default(uuid())
  userId       String?
  documentTypeId String
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  uploadedAt   DateTime  @default(now())

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int       @default(1)

  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([documentTypeId])
  @@map("document")
}

model DocumentTemplate {
  id           String    @id @default(uuid())
  templateCode String    @unique
  name         String
  templatePath String
  active       Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  @@map("document_template")
}

model Notification {
  id               String    @id @default(uuid())
  userId           String
  notificationTypeId String
  subject          String
  message          String
  readAt           DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notificationType NotificationType  @relation(fields: [notificationTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([notificationTypeId])
  @@map("notification")
}

model NotificationTemplate {
  id              String    @id @default(uuid())
  templateCode    String    @unique
  name            String
  subjectTemplate String
  bodyTemplate    String
  active          Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  @@map("notification_template")
}

model WorkflowEvent {
  id           String    @id @default(uuid())
  userId       String?
  workflowType String
  entityType   String
  entityId     String
  eventType    String
  occurredAt   DateTime  @default(now())
  payload      Json?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  user         User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([workflowType])
  @@map("workflow_event")
}

model AuditRecord {
  id         String    @id @default(uuid())
  userId     String?
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  deletedBy  String?

  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_record")
}

model IntegrationEndpoint {
  id                 String    @id @default(uuid())
  endpointCode       String    @unique
  provider           String
  baseUrl            String
  authenticationType String
  active             Boolean   @default(true)
  timeoutSeconds     Int       @default(30)
  retryCount         Int       @default(3)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  @@index([provider])
  @@map("integration_endpoint")
}

model SystemConfiguration {
  id                 String    @id @default(uuid())
  configurationKey   String    @unique
  configurationValue String
  category           String?
  encrypted          Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?

  @@index([category])
  @@map("system_configuration")
}
