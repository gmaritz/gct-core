  active      Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  executions  TourExecution[]

  @@index([code])
  @@map("execution_status")
}

model DocumentType {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  active      Boolean     @default(true)

  createdAt   DateTime    @default(now())
